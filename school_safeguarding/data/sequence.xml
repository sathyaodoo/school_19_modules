<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_school_safeguarding_case" model="ir.sequence">
        <field name="name">Safeguarding case</field>
        <field name="code">school.safeguarding.case</field>
        <field name="prefix">SG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="param_sg_retention_years" model="ir.config_parameter">
        <field name="key">school_safeguarding.retention_years</field>
        <field name="value">7</field>
    </record>
</odoo>
