<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_wb_case" model="ir.sequence">
            <field name="name">Well-being case</field>
            <field name="code">school.wellbeing.case</field>
            <field name="prefix">WB/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="area_social_adjustment" model="school.wellbeing.area"><field name="name">Social adjustment</field><field name="sequence">10</field></record>
        <record id="area_peer_relationships" model="school.wellbeing.area"><field name="name">Peer relationships</field><field name="sequence">20</field></record>
        <record id="area_academic_stress" model="school.wellbeing.area"><field name="name">Academic stress</field><field name="sequence">30</field></record>
        <record id="area_bullying" model="school.wellbeing.area"><field name="name">Bullying concern</field><field name="sequence">40</field></record>
        <record id="area_emotional" model="school.wellbeing.area"><field name="name">Emotional well-being</field><field name="sequence">50</field></record>
        <record id="area_family" model="school.wellbeing.area"><field name="name">Family / home</field><field name="sequence">60</field></record>
        <record id="area_behaviour" model="school.wellbeing.area"><field name="name">Behaviour / attendance</field><field name="sequence">70</field></record>
        <record id="area_other" model="school.wellbeing.area"><field name="name">Other</field><field name="sequence">99</field></record>
    </data>

    <!-- the Well-being Lead group needs somebody: the administrator, only when nobody is Lead yet (runs at every update) -->
    <function model="school.wellbeing.config" name="_ensure_default_config"/>
    <function model="school.wellbeing.config" name="_ensure_default_lead"/>
    <function model="school.wellbeing.config" name="_repair_case_references"/>
</odoo>
