<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scores attempts whose time is over and whose student never came back -->
        <record id="cron_oe_auto_submit_expired" model="ir.cron">
            <field name="name">Online Exam: auto-submit expired attempts</field>
            <field name="model_id" ref="model_school_oe_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_submit_expired()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
