<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_oe_practice_setting_list" model="ir.ui.view">
        <field name="name">school.oe.practice.setting.list</field>
        <field name="model">school.oe.practice.setting</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="practice_enabled"/>
            </list>
        </field>
    </record>

    <record id="action_school_oe_practice_setting" model="ir.actions.act_window">
        <field name="name">Practice Settings</field>
        <field name="res_model">school.oe.practice.setting</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Self-practice is open for every class and subject</p>
            <p>Add a line and untick "Practice Open" to close self-practice for one class / subject.</p>
        </field>
    </record>
</odoo>
