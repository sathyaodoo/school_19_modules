<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Assignments / Descriptive exams ============ -->
    <record id="view_school_oe_assignment_list" model="ir.ui.view">
        <field name="name">school.oe.assignment.list</field>
        <field name="model">school.oe.assignment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="kind"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="due_datetime"/>
                <field name="max_marks"/>
                <field name="student_count"/>
                <field name="submission_count"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_school_oe_assignment_form" model="ir.ui.view">
        <field name="name">school.oe.assignment.form</field>
        <field name="model">school.oe.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'published'"/>
                    <button name="action_draft" string="Back to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_send_for_approval" string="Send Marks for Approval" type="object"
                            invisible="not school_exam_id or state == 'draft'"
                            confirm="Send the marks of all evaluated submissions to the principal for approval?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                        <button name="action_view_mark_entries" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="mark_entry_count" widget="statinfo" string="Marks Approval"/>
                        </button>
                        <button name="action_view_submissions" type="object" class="oe_stat_button" icon="fa-upload">
                            <field name="submission_count" widget="statinfo" string="Submissions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Science Unit 2 - Answer Paper"/></h1>
                    </div>
                    <group>
                        <group string="Who / What">
                            <field name="kind"/>
                            <field name="class_id"/>
                            <field name="section_id" placeholder="Whole class"/>
                            <field name="subject_id"/>
                        </group>
                        <group string="Rules">
                            <field name="due_datetime"/>
                            <field name="duration_minutes"/>
                            <field name="allow_late"/>
                            <field name="max_marks"/>
                            <field name="school_exam_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question / Instructions" name="question">
                            <field name="instructions" placeholder="Type the question or instructions here..."/>
                            <group string="Question paper files (PDF / images)">
                                <field name="question_attachment_ids" widget="many2many_binary" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Students" name="students">
                            <field name="student_ids" readonly="1">
                                <list>
                                    <field name="admission_no"/>
                                    <field name="name"/>
                                    <field name="class_id"/>
                                    <field name="section_id"/>
                                    <field name="roll_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_oe_assignment_search" model="ir.ui.view">
        <field name="name">school.oe.assignment.search</field>
        <field name="model">school.oe.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_oe_assignment" model="ir.actions.act_window">
        <field name="name">Descriptive / Assignments</field>
        <field name="res_model">school.oe.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a descriptive exam or assignment</p>
            <p>Students upload their handwritten answer sheet (PDF / photos) from the portal,
               you give marks and feedback.</p>
        </field>
    </record>

    <!-- ============ Submissions (teacher evaluation) ============ -->
    <record id="view_school_oe_submission_list" model="ir.ui.view">
        <field name="name">school.oe.submission.list</field>
        <field name="model">school.oe.submission</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'submitted'" decoration-success="state == 'evaluated'"
                  decoration-muted="state == 'draft'">
                <field name="assignment_id"/>
                <field name="student_id"/>
                <field name="class_id" optional="hide"/>
                <field name="submitted_datetime"/>
                <field name="is_late"/>
                <field name="file_count"/>
                <field name="state" widget="badge"/>
                <field name="marks"/>
                <field name="max_marks"/>
            </list>
        </field>
    </record>

    <record id="view_school_oe_submission_form" model="ir.ui.view">
        <field name="name">school.oe.submission.form</field>
        <field name="model">school.oe.submission</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_evaluate" string="Save &amp; Mark as Evaluated" type="object"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reopen_evaluation" string="Re-evaluate" type="object"
                            invisible="state != 'evaluated'"/>
                    <button name="action_return_to_student" string="Return to Student" type="object"
                            invisible="state == 'draft'"
                            confirm="The student will be able to change the files and submit again. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,evaluated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="assignment_id"/>
                            <field name="student_id"/>
                            <field name="started_datetime"/>
                            <field name="submitted_datetime"/>
                            <field name="is_late"/>
                        </group>
                        <group string="Evaluation">
                            <field name="marks" readonly="state == 'evaluated'"/>
                            <field name="max_marks"/>
                            <field name="evaluated_by"/>
                            <field name="evaluated_datetime"/>
                        </group>
                    </group>
                    <group string="Student's uploaded files (click to open / download)">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <field name="note" readonly="1"/>
                        <field name="feedback" readonly="state == 'evaluated'"
                               placeholder="Write feedback for the student..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_oe_submission_search" model="ir.ui.view">
        <field name="name">school.oe.submission.search</field>
        <field name="model">school.oe.submission</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="assignment_id"/>
                <field name="class_id"/>
                <filter name="to_evaluate" string="To Evaluate" domain="[('state', '=', 'submitted')]"/>
                <filter name="evaluated" string="Evaluated" domain="[('state', '=', 'evaluated')]"/>
                <filter name="not_submitted" string="Not Submitted" domain="[('state', '=', 'draft')]"/>
                <filter name="late" string="Late" domain="[('is_late', '=', True)]"/>
                <group>
                    <filter name="group_assignment" string="Assignment" context="{'group_by': 'assignment_id'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_oe_submission" model="ir.actions.act_window">
        <field name="name">Evaluate Submissions</field>
        <field name="res_model">school.oe.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="context">{'search_default_to_evaluate': 1}</field>
    </record>
</odoo>
