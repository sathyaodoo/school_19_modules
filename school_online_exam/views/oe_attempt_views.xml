<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_oe_attempt_list" model="ir.ui.view">
        <field name="name">school.oe.attempt.list</field>
        <field name="model">school.oe.attempt</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'in_progress'"
                  decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                <field name="exam_id"/>
                <field name="exam_type" optional="show"/>
                <field name="student_id"/>
                <field name="class_id" optional="hide"/>
                <field name="attempt_no"/>
                <field name="start_datetime"/>
                <field name="submit_datetime" optional="show"/>
                <field name="state"/>
                <field name="score" sum="Total"/>
                <field name="total_marks"/>
                <field name="percentage" widget="percentage" optional="hide"/>
                <field name="correct_count" optional="show"/>
                <field name="answered_count" optional="show"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_school_oe_attempt_form" model="ir.ui.view">
        <field name="name">school.oe.attempt.form</field>
        <field name="model">school.oe.attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="in_progress,submitted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="exam_id"/>
                            <field name="student_id"/>
                            <field name="attempt_no"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="deadline"/>
                            <field name="submit_datetime"/>
                            <field name="time_taken"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="score"/>
                            <field name="total_marks"/>
                            <field name="percentage"/>
                        </group>
                        <group>
                            <field name="correct_count"/>
                            <field name="answered_count"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions &amp; Answers" name="lines">
                            <field name="line_ids">
                                <list decoration-success="is_correct" decoration-danger="not is_correct and selected_option">
                                    <field name="sequence"/>
                                    <field name="question_text"/>
                                    <field name="selected_option"/>
                                    <field name="correct_key"/>
                                    <field name="is_correct"/>
                                    <field name="marks_obtained" sum="Score"/>
                                    <field name="marks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_oe_attempt_search" model="ir.ui.view">
        <field name="name">school.oe.attempt.search</field>
        <field name="model">school.oe.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <filter name="type_exam" string="Exams" domain="[('exam_type', '=', 'exam')]"/>
                <filter name="type_mock" string="Mock Tests" domain="[('exam_type', '=', 'mock')]"/>
                <filter name="type_practice" string="Self Practice" domain="[('exam_type', '=', 'practice')]"/>
                <separator/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="auto_submitted" string="Auto-submitted" domain="[('state', '=', 'auto_submitted')]"/>
                <separator/>
                <filter name="passed" string="Passed" domain="[('result', '=', 'pass')]"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'fail')]"/>
                <group>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_exam" string="Exam" context="{'group_by': 'exam_id'}"/>
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_oe_attempt" model="ir.actions.act_window">
        <field name="name">Attempt History</field>
        <field name="res_model">school.oe.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_student': 1}</field>
    </record>
</odoo>
