<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_canteen_menu" model="ir.sequence">
            <field name="name">Canteen Menu ID</field>
            <field name="code">school.canteen.menu</field>
            <field name="prefix">MENU/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_school_canteen_daily_planning" model="ir.sequence">
            <field name="name">Canteen Daily Planning ID</field>
            <field name="code">school.canteen.daily.planning</field>
            <field name="prefix">PLAN/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>