<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_early_warning" model="ir.sequence">
            <field name="name">Early Warning Alert</field>
            <field name="code">school.early.warning</field>
            <field name="prefix">EWS/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="ir_cron_early_warning_scan" model="ir.cron">
            <field name="name">Early Warning: Daily Scan</field>
            <field name="model_id" ref="model_school_early_warning"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=6, minute=30, second=0))"/>
        </record>

        <!-- Interventions a reviewer can choose (add more in Configuration) -->
        <record id="ews_intervention_counselling" model="school.early.warning.intervention"><field name="name">Counselling session</field><field name="sequence">10</field></record>
        <record id="ews_intervention_parent_meeting" model="school.early.warning.intervention"><field name="name">Parent / guardian meeting</field><field name="sequence">20</field></record>
        <record id="ews_intervention_remedial" model="school.early.warning.intervention"><field name="name">Remedial classes</field><field name="sequence">30</field></record>
        <record id="ews_intervention_mentoring" model="school.early.warning.intervention"><field name="name">Mentoring by class teacher</field><field name="sequence">40</field></record>
        <record id="ews_intervention_attendance" model="school.early.warning.intervention"><field name="name">Attendance follow-up</field><field name="sequence">50</field></record>
        <record id="ews_intervention_activity" model="school.early.warning.intervention"><field name="name">Encourage activity participation</field><field name="sequence">60</field></record>
        <record id="ews_intervention_referral" model="school.early.warning.intervention"><field name="name">Referral to specialist</field><field name="sequence">70</field></record>
    </data>
</odoo>