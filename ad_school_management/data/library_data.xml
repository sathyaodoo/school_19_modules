<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Numbering -->
        <record id="seq_school_book_copy" model="ir.sequence">
            <field name="name">Library Accession Number</field>
            <field name="code">school.book.copy</field>
            <field name="prefix">ACC/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_school_book_copy_barcode" model="ir.sequence">
            <field name="name">Library Book Barcode</field>
            <field name="code">school.book.copy.barcode</field>
            <field name="prefix"></field>
            <field name="padding">10</field>
            <field name="number_next">1000000001</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_library_membership" model="ir.sequence">
            <field name="name">Library Card Number</field>
            <field name="code">school.library.membership</field>
            <field name="prefix">LIB/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_school_library_stock_verification" model="ir.sequence">
            <field name="name">Library Stock Verification</field>
            <field name="code">school.library.stock.verification</field>
            <field name="prefix">STV/%(year)s/</field>
            <field name="padding">3</field>
        </record>

        <!-- Daily jobs -->
        <record id="ir_cron_library_overdue_alerts" model="ir.cron">
            <field name="name">Library: Overdue Alerts</field>
            <field name="model_id" ref="model_school_book_issue"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=7, minute=0, second=0))"/>
        </record>
        <record id="ir_cron_library_expire_reservations" model="ir.cron">
            <field name="name">Library: Expire Uncollected Reservations</field>
            <field name="model_id" ref="model_school_book_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_reservations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=7, minute=5, second=0))"/>
        </record>

        <!-- Starter genres (add / rename / archive in Configuration > Book Genres) -->
        <record id="genre_fiction" model="school.book.genre"><field name="name">Fiction</field></record>
        <record id="genre_non_fiction" model="school.book.genre"><field name="name">Non-Fiction</field></record>
        <record id="genre_science" model="school.book.genre"><field name="name">Science</field></record>
        <record id="genre_history" model="school.book.genre"><field name="name">History</field></record>
        <record id="genre_academic" model="school.book.genre"><field name="name">Academic</field></record>
        <record id="genre_biography" model="school.book.genre"><field name="name">Biography</field></record>
        <record id="genre_adventure" model="school.book.genre"><field name="name">Adventure</field></record>
        <record id="genre_poetry" model="school.book.genre"><field name="name">Poetry</field></record>
        <record id="genre_comics" model="school.book.genre"><field name="name">Comics &amp; Graphic Novels</field></record>
        <record id="genre_reference" model="school.book.genre"><field name="name">Reference</field></record>
        <record id="genre_other" model="school.book.genre"><field name="name">Other</field></record>
    </data>
</odoo>