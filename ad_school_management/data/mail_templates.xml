<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="email_template_admission_submitted" model="mail.template">
            <field name="name">Admission Application: Submitted</field>
            <field name="model_id" ref="ad_school_management.model_school_admission"/>
            <field name="subject">Admission Application Submitted - {{ object.name }}</field>
            <field name="email_from">{{ object.create_uid.email or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Roboto', sans-serif;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.first_name"/> <t t-out="object.last_name"/>,<br/><br/>
                        We have successfully received your admission application with reference <strong><t t-out="object.name"/></strong> for the Academic Year <strong><t t-out="object.academic_year_id.name"/></strong>.
                        <br/><br/>
                        Our admissions department is reviewing your details. We will contact you soon.
                        <br/><br/>
                        Best regards,<br/>
                        Admissions Team
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_admission_approved" model="mail.template">
            <field name="name">Admission Application: Approved</field>
            <field name="model_id" ref="ad_school_management.model_school_admission"/>
            <field name="subject">Admission Application Approved! - {{ object.name }}</field>
            <field name="email_from">{{ object.create_uid.email or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Roboto', sans-serif;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.first_name"/> <t t-out="object.last_name"/>,<br/><br/>
                        Congratulations! Your admission application <strong><t t-out="object.name"/></strong> has been <strong>Approved</strong>.
                        <br/><br/>
                        You are now ready to be enrolled in Class <strong><t t-out="object.class_id.name"/></strong>.
                        <br/><br/>
                        Please visit the school office to complete the remaining enrollment procedures.
                        <br/><br/>
                        Best regards,<br/>
                        Admissions Team
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
