<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_purge_vehicle_locations" model="ir.cron">
        <field name="name">School Transport: Purge GPS locations older than 30 days</field>
        <field name="model_id" ref="model_school_vehicle_location"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_locations(days=30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
