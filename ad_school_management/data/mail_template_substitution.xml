<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_teacher_substitution" model="mail.template">
            <field name="name">Teacher Substitution: Assigned</field>
            <field name="model_id" ref="ad_school_management.model_school_substitution"/>
            <field name="subject">Substitution: {{ object.class_id.name }} {{ object.section_id.name or '' }} – {{ object.subject_id.name }} on {{ format_date(object.date) }}</field>
            <field name="email_from">{{ (user.email_formatted or object.company_id.email_formatted or '') }}</field>
            <!-- Odoo 19: "Default Recipients" is on by default and would ignore
                 email_to (a substitution has no contact of its own). -->
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object.substitute_teacher_id.work_email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.substitute_teacher_id.name or ''"/>,</p>
    <p>You have been assigned as the <strong>substitute teacher</strong> for the following period,
       because <t t-out="object.absent_teacher_id.name or ''"/> is on leave:</p>
    <table style="border-collapse: collapse;" cellpadding="6">
        <tr><td style="border: 1px solid #ddd;"><strong>Date</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="format_date(object.date)"/></td></tr>
        <tr><td style="border: 1px solid #ddd;"><strong>Time</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="object.period_label"/></td></tr>
        <tr><td style="border: 1px solid #ddd;"><strong>Class</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="object.class_id.name or ''"/> <t t-out="object.section_id.name or ''"/></td></tr>
        <tr><td style="border: 1px solid #ddd;"><strong>Subject</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="object.subject_id.name or ''"/></td></tr>
        <tr><td style="border: 1px solid #ddd;"><strong>Classroom</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="object.classroom or ''"/></td></tr>
    </table>
    <p>Thank you.</p>
</div>
            </field>
        </record>
    </data>
</odoo>