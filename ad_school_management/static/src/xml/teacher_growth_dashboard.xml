<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ad_school_management.TeacherGrowthDashboard">
        <div class="o_school_dashboard o_teacher_growth p-4">
            <t t-set="d" t-value="state.data"/>
            <!-- header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h2 class="mb-0"><i class="fa fa-line-chart text-primary me-2"/>Teacher Growth Portfolio</h2>
                    <div class="text-muted">Professional development: training, certifications, classroom
                        practice, research, reflection and annual goals.</div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <select t-if="d.years and d.years.length" class="form-select form-select-sm" style="width: auto;"
                            t-on-change="onYearChange">
                        <t t-foreach="d.years" t-as="y" t-key="y.id">
                            <option t-att-value="y.id" t-att-selected="d.year and d.year.id == y.id" t-out="y.name"/>
                        </t>
                    </select>
                    <button t-if="d.is_admin and d.portfolio" class="btn btn-sm btn-outline-secondary" t-on-click="backToOverview">
                        <i class="fa fa-arrow-left me-1"/>All Teachers
                    </button>
                    <button t-if="d.portfolio" class="btn btn-sm btn-outline-primary" t-on-click="printPortfolio">
                        <i class="fa fa-print me-1"/>Print Portfolio
                    </button>
                    <button t-if="d.my_portfolio or (d.portfolio and !d.is_manager)" class="btn btn-sm btn-primary" t-on-click="() => this.newActivity()">
                        <i class="fa fa-plus me-1"/>Add Activity
                    </button>
                </div>
            </div>

            <!-- ============ Staff Leave Requests (Admin / HR / Principal) ============ -->
            <div t-if="state.data.leaves and state.data.leaves.visible" class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded bg-white o_school_leave_panel">
                            <div class="card-header border-0 bg-transparent py-3 d-flex justify-content-between align-items-center">
                                <h5 class="card-title font-weight-bold text-dark mb-0">
                                    <i class="fa fa-bell text-warning me-2"/>Staff Leave Requests
                                    <span t-if="state.data.leaves.total_pending" class="badge rounded-pill text-bg-danger ms-2">
                                        <t t-out="state.data.leaves.total_pending"/> pending
                                    </span>
                                </h5>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openLeaveApprovals()">
                                    View all
                                </button>
                            </div>
                            <div class="card-body pt-0">
                                <div class="row text-center mb-3">
                                    <div class="col-4">
                                        <div class="o_school_leave_stage p-2 rounded cursor-pointer" t-on-click="() => this.openLeaveApprovals('admin')">
                                            <h3 class="mb-0 text-primary" t-out="state.data.leaves.pending_admin"/>
                                            <small class="text-muted">Waiting for Admin</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_school_leave_stage p-2 rounded cursor-pointer" t-on-click="() => this.openLeaveApprovals('hr')">
                                            <h3 class="mb-0 text-info" t-out="state.data.leaves.pending_hr"/>
                                            <small class="text-muted">Waiting for HR Manager</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="o_school_leave_stage p-2 rounded cursor-pointer" t-on-click="() => this.openLeaveApprovals('principal')">
                                            <h3 class="mb-0 text-success" t-out="state.data.leaves.pending_principal"/>
                                            <small class="text-muted">Waiting for Principal</small>
                                        </div>
                                    </div>
                                </div>

                                <div t-if="!state.data.leaves.recent.length" class="text-muted text-center py-2">
                                    No leave requests waiting for approval.
                                </div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Employee</th>
                                                <th>Leave Type</th>
                                                <th>From</th>
                                                <th>To</th>
                                                <th class="text-end">Days</th>
                                                <th>Reason</th>
                                                <th>Applied On</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.leaves.recent" t-as="leave" t-key="leave.id"
                                                class="cursor-pointer" t-on-click="() => this.openLeave(leave.id)">
                                                <td class="fw-bold" t-out="leave.employee"/>
                                                <td t-out="leave.leave_type"/>
                                                <td t-out="leave.date_from"/>
                                                <td t-out="leave.date_to"/>
                                                <td class="text-end" t-out="leave.days"/>
                                                <td class="text-truncate" style="max-width: 220px;" t-out="leave.reason"/>
                                                <td class="text-muted" t-out="leave.applied_on"/>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill #{leave.stage == 'admin' ? 'text-bg-primary' : leave.stage == 'hr' ? 'text-bg-info' : 'text-bg-success'}"
                                                          t-out="leave.stage_label"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            <div t-if="state.loading" class="text-center text-muted p-5"><i class="fa fa-spinner fa-spin fa-2x"/></div>

            <div t-elif="d.no_teacher" class="alert alert-info">
                Your user is not linked to a teacher profile, so there is no personal portfolio to show.
            </div>

            <!-- ================= ONE TEACHER'S PORTFOLIO ================= -->
            <t t-elif="d.portfolio">
                <t t-set="p" t-value="d.portfolio"/>
                <h4 class="mb-3"><t t-out="p.teacher.name"/> <small class="text-muted" t-if="d.year">– <t t-out="d.year.name"/></small></h4>
                <div class="row mb-4">
                    <div class="col-md-6 col-xl-3 mb-3">
                        <div class="card border-0 shadow-sm h-100 o_growth_kpi">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">CPD Hours</div>
                                <div class="h2 mb-1"><t t-out="p.hours"/> <small class="text-muted fs-6">/ <t t-out="p.target"/> h</small></div>
                                <div class="progress" style="height: 8px;">
                                    <div t-attf-class="progress-bar #{p.percent >= 100 ? 'bg-success' : 'bg-primary'}" t-attf-style="width: #{p.percent}%"/>
                                </div>
                                <div class="small text-muted mt-1"><t t-out="p.percent"/>% of the annual target</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3 mb-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_growth_kpi" t-on-click="() => this.openActivities(null, 'submitted')">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Submitted Activities</div>
                                <div class="h2 mb-1" t-out="p.activity_count"/>
                                <div class="small">
                                    <span class="text-muted" t-if="p.drafts"><t t-out="p.drafts"/> in draft</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3 mb-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_growth_kpi" t-on-click="openGoals">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Annual Goals Met</div>
                                <div class="h2 mb-1"><t t-out="p.goals_met"/> <small class="text-muted fs-6">/ <t t-out="p.goals.length"/></small></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3 mb-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_growth_kpi" t-on-click="openReflections">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Self-Reflections</div>
                                <div class="h2 mb-1" t-out="p.reflection_count"/>
                                <div class="small text-muted"><t t-out="p.shared_reflections"/> shared with the Principal</div>
                            </div>
                        </div>
                    </div>
                </div>

                <t t-call="ad_school_management.TeacherGrowthPortfolioBody">
                    <t t-set="own" t-value="false"/>
                </t>
            </t>

            <!-- ================= SCHOOL OVERVIEW (Principal / HR / Admin) ================= -->
            <t t-elif="d.overview">
                <t t-set="o" t-value="d.overview"/>
                <div class="row mb-4">
                    <div class="col-6 col-xl-3 mb-3"><div class="card border-0 shadow-sm h-100 o_growth_kpi"><div class="card-body">
                        <div class="text-muted small text-uppercase">Teachers</div><div class="h2 mb-0" t-out="o.teacher_count"/></div></div></div>
                    <div class="col-6 col-xl-3 mb-3"><div class="card border-0 shadow-sm h-100 o_growth_kpi"><div class="card-body">
                        <div class="text-muted small text-uppercase">Average CPD Hours</div>
                        <div class="h2 mb-0"><t t-out="o.avg_hours"/> <small class="text-muted fs-6">/ <t t-out="d.target_hours"/> h</small></div></div></div></div>
                    <div class="col-6 col-xl-3 mb-3"><div class="card border-0 shadow-sm h-100 o_growth_kpi"><div class="card-body">
                        <div class="text-muted small text-uppercase">Below Target</div><div class="h2 mb-0 text-danger" t-out="o.below_target"/></div></div></div>
                    <div class="col-6 col-xl-3 mb-3"><div class="card border-0 shadow-sm h-100 o_growth_kpi"><div class="card-body">
                        <div class="text-muted small text-uppercase">Total CPD Hours</div><div class="h2 mb-0 text-info" t-out="o.total_hours"/></div></div></div>
                </div>

                <h5 class="mb-3">Submitted Activities by Type</h5>
                <div class="row mb-4">
                    <t t-foreach="o.by_type" t-as="t" t-key="t.id">
                        <div class="col-6 col-md-4 col-xl-2 mb-3">
                            <div class="card border-0 shadow-sm h-100 text-center cursor-pointer o_growth_type" t-on-click="() => this.openActivities(t.id, 'submitted')">
                                <div class="card-body p-3">
                                    <i t-attf-class="fa #{t.icon} fa-2x text-primary mb-2"/>
                                    <div class="h4 mb-0" t-out="t.count"/>
                                    <div class="small" t-out="t.name"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- My own goals and activities (a manager who is also a teacher) - only this user's data -->
                <t t-if="d.my_portfolio">
                    <t t-set="p" t-value="d.my_portfolio"/>
                    <h4 class="mb-1">My Professional Development</h4>
                    <div class="text-muted small mb-3">Your own goals and activities - only you can see this section.</div>
                    <t t-call="ad_school_management.TeacherGrowthPortfolioBody">
                        <t t-set="own" t-value="true"/>
                    </t>
                </t>

                <!-- Per-teacher list: School Admin only -->
                <div t-if="d.is_admin" class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0"><h5 class="mb-0">Teachers <small class="text-muted">(click a teacher to open the portfolio)</small></h5></div>
                    <div class="card-body pt-0 table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Teacher</th><th style="min-width: 180px;">CPD Hours</th><th class="text-end">Activities</th>
                                    <th class="text-end">Goals Met</th><th>Last Reflection</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.teachers" t-as="r" t-key="r.id" class="cursor-pointer" t-on-click="() => this.openTeacher(r.id)">
                                    <td class="fw-bold"><t t-out="r.name"/>
                                        <span t-if="r.below_target" class="badge text-bg-warning ms-1">below target</span></td>
                                    <td>
                                        <div class="d-flex justify-content-between small"><span><t t-out="r.hours"/> h</span><span><t t-out="r.percent"/>%</span></div>
                                        <div class="progress" style="height: 6px;">
                                            <div t-attf-class="progress-bar #{r.percent >= 100 ? 'bg-success' : 'bg-primary'}" t-attf-style="width: #{r.percent}%"/>
                                        </div>
                                    </td>
                                    <td class="text-end" t-out="r.activities"/>
                                    <td class="text-end"><t t-out="r.goals_met"/> / <t t-out="r.goals"/></td>
                                    <td class="small text-muted" t-out="r.last_reflection or '-'"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <!-- What I Have Done + Annual Goals + Recent Activities (one teacher). Used for a teacher's own
         portfolio, for the School Admin opening a teacher, and for a manager's own block. -->
    <t t-name="ad_school_management.TeacherGrowthPortfolioBody">
        <!-- the BRS activity types -->
        <h5 class="mb-3">What I Have Done</h5>
        <div class="row mb-4">
            <t t-foreach="p.by_type" t-as="t" t-key="t.id">
                <div class="col-6 col-md-4 col-xl-2 mb-3">
                    <div class="card border-0 shadow-sm h-100 text-center cursor-pointer o_growth_type" t-on-click="() => this.openActivities(t.id, null, own)">
                        <div class="card-body p-3">
                            <i t-attf-class="fa #{t.icon} fa-2x text-primary mb-2"/>
                            <div class="h4 mb-0" t-out="t.count"/>
                            <div class="small" t-out="t.name"/>
                            <div class="small text-muted" t-if="t.hours"><t t-out="t.hours"/> h</div>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between">
                        <h5 class="mb-0">Annual Professional-Development Goals</h5>
                        <button class="btn btn-sm btn-link" t-on-click="() => this.openGoals(own)">Open</button>
                    </div>
                    <div class="card-body pt-0">
                        <div t-if="!p.goals.length" class="text-muted">No goals for this year yet.</div>
                        <div t-foreach="p.goals" t-as="g" t-key="g.id" class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span><i t-if="g.is_met" class="fa fa-check-circle text-success me-1"/><t t-out="g.name"/></span>
                                <small class="text-muted">
                                    <t t-if="g.measure != 'qualitative'"><t t-out="g.achieved"/> / <t t-out="g.target"/> · </t><t t-out="g.state"/>
                                </small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div t-attf-class="progress-bar #{g.is_met ? 'bg-success' : 'bg-info'}" t-attf-style="width: #{g.progress}%"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between">
                        <h5 class="mb-0">Recent Activities</h5>
                        <button class="btn btn-sm btn-link" t-on-click="() => this.openActivities(null, null, own)">All</button>
                    </div>
                    <div class="card-body pt-0">
                        <div t-if="!p.recent.length" class="text-muted">No activities recorded this year.</div>
                        <table t-else="" class="table table-sm table-hover mb-0">
                            <tbody>
                                <tr t-foreach="p.recent" t-as="a" t-key="a.id" class="cursor-pointer" t-on-click="() => this.openActivity(a.id)">
                                    <td><i t-attf-class="fa #{a.icon} text-primary me-2"/><t t-out="a.name"/>
                                        <div class="small text-muted"><t t-out="a.type"/> · <t t-out="a.date"/></div></td>
                                    <td class="text-end"><t t-if="a.hours"><t t-out="a.hours"/> h</t></td>
                                    <td class="text-end">
                                        <span t-attf-class="badge #{a.state_key == 'submitted' ? 'text-bg-success' : 'text-bg-light border'}" t-out="a.state"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>