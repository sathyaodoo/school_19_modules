<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_bulk_student_import_form" model="ir.ui.view">
        <field name="name">school.bulk.student.import.form</field>
        <field name="model">school.bulk.student.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="academic_year_id"/>
                        <field name="class_id"/>
                    </group>
                    <group>
                        <field name="section_id" domain="[('class_id', '=', class_id)]"/>
                    </group>
                </group>
                <notebook>
                    <page string="Students List" name="students">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="roll_number"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_import" string="Import Students" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_bulk_student_import" model="ir.actions.act_window">
        <field name="name">Bulk Student Import</field>
        <field name="res_model">school.bulk.student.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
