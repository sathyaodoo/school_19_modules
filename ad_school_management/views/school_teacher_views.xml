<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="teacher_code"/>
                <field name="name"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="qualification"/>
                <field name="specialization"/>
            </list>
        </field>
    </record>

    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Teacher Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Academic Information">
                            <field name="teacher_code"/>
                            <field name="qualification"/>
                            <field name="specialization"/>
                            <field name="joining_date"/>
                            <field name="class_teacher_for"/>
                            <field name="teacher_type"/>
                        </group>
                        <group string="Contact Info">
                            <field name="work_email"/>
                            <field name="work_phone"/>
                            <field name="mobile_phone"/>
                            <field name="is_own_driver"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Classes" name="classes">
                            <field name="class_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Assigned Subjects" name="subjects">
                            <field name="subject_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_teacher_search" model="ir.ui.view">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="teacher_code"/>
                <field name="qualification"/>
                <field name="specialization"/>
            </search>
        </field>
    </record>

    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_teacher_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new teacher profile!
            </p>
        </field>
    </record>
        <record id="view_hr_applicant_form_school_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.form.school.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='campaign_id']" position="after">
                <group string="Resume &amp; Cover Letter">
                    <field name="resume_attachment" filename="resume_attachment_filename"/>
                    <field name="resume_attachment_filename" invisible="1"/>
                    <field name="cover_letter"/>
                </group>
            </xpath>
        </field>
    </record>
     <record id="view_hr_applicant_interview_list" model="ir.ui.view">
        <field name="name">hr.applicant.interview.list</field>
        <field name="model">hr.applicant.interview</field>
        <field name="arch" type="xml">
            <list>
                <field name="application_id"/>
                <field name="interview_date"/>
                <field name="interview_time" widget="float_time"/>
                <field name="interviewer_id"/>
                <field name="interview_type"/>
            </list>
        </field>
    </record>

    <record id="view_hr_applicant_interview_form" model="ir.ui.view">
        <field name="name">hr.applicant.interview.form</field>
        <field name="model">hr.applicant.interview</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="application_id"/>
                            <field name="interview_date"/>
                            <field name="interview_time" widget="float_time"/>
                        </group>
                        <group>
                            <field name="interviewer_id"/>
                            <field name="interview_type"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="interview_notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_applicant_interview" model="ir.actions.act_window">
        <field name="name">Interviews</field>
        <field name="res_model">hr.applicant.interview</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule an interview!
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_applicant_interview"
        name="Interviews"
        parent="hr_recruitment.menu_hr_recruitment_root"
        action="action_hr_applicant_interview"
        sequence="15"/>
</odoo>
