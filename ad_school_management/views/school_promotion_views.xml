<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_promotion_tree" model="ir.ui.view">
        <field name="name">school.promotion.tree</field>
        <field name="model">school.promotion</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="academic_year_from_id"/>
                <field name="academic_year_to_id"/>
                <field name="class_from_id"/>
                <field name="class_to_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_school_promotion_form" model="ir.ui.view">
        <field name="name">school.promotion.form</field>
        <field name="model">school.promotion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_promote" type="object" string="Execute Promotion" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Academic Years">
                            <field name="academic_year_from_id"/>
                            <field name="academic_year_to_id"/>
                        </group>
                        <group string="Classes">
                            <field name="class_from_id"/>
                            <field name="class_to_id"/>
                            <field name="ignore_unpaid_fees"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students to Promote" name="students">
                            <field name="student_ids" domain="[('class_id', '=', class_from_id), ('academic_year_id', '=', academic_year_from_id)]">
                                <list>
                                    <field name="admission_no"/>
                                    <field name="name"/>
                                    <field name="roll_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_promotion" model="ir.actions.act_window">
        <field name="name">Student Promotions</field>
        <field name="res_model">school.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Setup a Promotion Run!
            </p>
        </field>
    </record>
</odoo>
