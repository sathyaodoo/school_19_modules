<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <template id="portal_my_home_school" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">School Profile(s)</t>
                <t t-set="url" t-value="'/my/school/students'"/>
                <t t-set="placeholder_count" t-value="'student_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Trips (Driver)</t>
                <t t-set="url" t-value="'/my/driver'"/>
                <t t-set="placeholder_count" t-value="'driver_route_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_school" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('school_students', 'school_student_profile', 'school_student_bus')" class="breadcrumb-item active">
                <a t-if="page_name == 'school_student_profile'" href="/my/school/students">School Profiles</a>
                <t t-else="">School Profiles</t>
            </li>
            <li t-if="page_name == 'school_student_profile'" class="breadcrumb-item active">
                <t t-out="student.name"/>
            </li>
            <li t-if="page_name in ('school_driver', 'school_driver_trip')" class="breadcrumb-item active">
                <a t-if="page_name == 'school_driver_trip'" href="/my/driver">My Trips</a>
                <t t-else="">My Trips</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_students" name="My School Students">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h3 class="mb-4">Associated Student Profiles</h3>
                        <div class="row" t-if="students">
                            <t t-foreach="students" t-as="student">
                                <div class="col-md-4 col-sm-6 mb-4">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body text-center">
                                            <img t-att-src="image_data_uri(student.photo) if student.photo else '/web/static/img/placeholder.png'"
                                                 class="rounded-circle mb-3 border" style="width: 100px; height: 100px; object-fit: cover;"/>
                                            <h5 class="card-title text-primary"><t t-out="student.name"/></h5>
                                            <p class="card-text text-muted mb-1">Admission No: <t t-out="student.admission_no"/></p>
                                            <p class="card-text text-muted mb-3">Class: <t t-out="student.class_id.name"/> - <t t-out="student.section_id.name"/></p>
                                            <a t-attf-href="/my/school/student/#{student.id}" class="btn btn-outline-primary btn-sm">View Profile &amp; Dashboard</a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="alert alert-info">
                            No student profiles found associated with your portal user.
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_student_profile" name="Student Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                
                <div class="card shadow-sm border-0 mb-4 bg-light">
                    <div class="card-body d-flex align-items-center">
                        <img t-att-src="image_data_uri(student.photo) if student.photo else '/web/static/img/placeholder.png'"
                             class="rounded-circle border me-4" style="width: 120px; height: 120px; object-fit: cover;"/>
                        <div>
                            <h2 class="text-primary mb-1"><t t-out="student.name"/></h2>
                            <p class="mb-1"><strong>Admission No:</strong> <t t-out="student.admission_no"/> | <strong>Roll Number:</strong> <t t-out="student.roll_number"/></p>
                            <p class="mb-0"><strong>Class:</strong> <t t-out="student.class_id.name"/> - <t t-out="student.section_id.name"/> | <strong>Academic Year:</strong> <t t-out="student.academic_year_id.name"/></p>
                            <a t-if="student.transport_route_id" t-attf-href="/my/school/student/#{student.id}/bus"
                               class="btn btn-primary btn-sm mt-2">
                                <i class="fa fa-bus me-1"/> Bus Live Location
                            </a>
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-4" id="studentTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="true">Profile Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab" aria-controls="attendance" aria-selected="false">Attendance</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results" type="button" role="tab" aria-controls="results" aria-selected="false">Results</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="timetable-tab" data-bs-toggle="tab" data-bs-target="#timetable" type="button" role="tab" aria-controls="timetable" aria-selected="false">Timetable</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices" type="button" role="tab" aria-controls="invoices" aria-selected="false">Invoices/Fees</button>
                    </li>
                </ul>

                <div class="tab-content" id="studentTabContent">
                    
                    <div class="tab-pane fade show active" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                        <div class="card shadow-sm border-0 p-4">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <h5 class="text-secondary border-bottom pb-2">Personal Information</h5>
                                    <p><strong>Date of Birth:</strong> <t t-out="student.date_of_birth"/></p>
                                    <p><strong>Gender:</strong> <t t-out="student.gender"/></p>
                                    <p><strong>Blood Group:</strong> <t t-out="student.blood_group"/></p>
                                    <p><strong>Nationality:</strong> <t t-out="student.nationality_id.name"/></p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <h5 class="text-secondary border-bottom pb-2">Contact Details</h5>
                                    <p><strong>Email:</strong> <t t-out="student.email"/></p>
                                    <p><strong>Phone:</strong> <t t-out="student.phone"/></p>
                                    <p><strong>Address:</strong> <t t-out="student.contact_address"/></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="attendance" role="tabpanel" aria-labelledby="attendance-tab">
                        <div class="card shadow-sm border-0 p-4">
                            <h5 class="text-secondary mb-3">Recent Attendance Logs (Max 15)</h5>
                            <div class="table-responsive" t-if="attendances">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Class / Section</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="attendances" t-as="att">
                                            <tr>
                                                <td><t t-out="att.date"/></td>
                                                <td><t t-out="att.class_id.name"/> - <t t-out="att.section_id.name"/></td>
                                                <td>
                                                    <span t-attf-class="badge bg-#{'success' if att.status == 'present' else 'danger' if att.status == 'absent' else 'warning' if att.status == 'late' else 'info'}">
                                                        <t t-out="att.status.capitalize()"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="alert alert-info mb-0">
                                No attendance records found.
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="results" role="tabpanel" aria-labelledby="results-tab">
                        <div class="card shadow-sm border-0 p-4">
                            <h5 class="text-secondary mb-3">Academic Results</h5>
                            <div class="table-responsive" t-if="results">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Exam</th>
                                            <th>Subject</th>
                                            <th>Obtained Marks</th>
                                            <th>Max Marks</th>
                                            <th>Grade</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="results" t-as="res">
                                            <tr>
                                                <td><t t-out="res.exam_id.name"/></td>
                                                <td><t t-out="res.subject_id.name"/></td>
                                                <td><t t-out="res.marks_obtained"/></td>
                                                <td><t t-out="res.max_marks"/></td>
                                                <td><t t-out="res.grade_id.grade or '-'"/> (GPA: <t t-out="res.gpa"/>)</td>
                                                <td>
                                                    <span t-attf-class="badge bg-#{'success' if res.result_status == 'pass' else 'danger'}">
                                                        <t t-out="res.result_status.capitalize()"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="alert alert-info mb-0">
                                No exam results published yet.
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="timetable" role="tabpanel" aria-labelledby="timetable-tab">
                        <div class="card shadow-sm border-0 p-4">
                            <h5 class="text-secondary mb-3">Class Timetable Schedule</h5>
                            <div class="table-responsive" t-if="timetable and timetable.timetable_line_ids">
                                <table class="table table-bordered">
                                    <thead class="table-light text-center">
                                        <tr>
                                            <th>Day</th>
                                            <th>Subject</th>
                                            <th>Teacher</th>
                                            <th>Classroom</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="timetable.timetable_line_ids" t-as="line">
                                            <tr>
                                                <td><strong class="text-capitalize"><t t-out="line.day_of_week"/></strong></td>
                                                <td><t t-out="line.subject_id.name"/></td>
                                                <td><t t-out="line.teacher_id.name"/></td>
                                                <td><t t-out="line.classroom"/></td>
                                                <td class="text-center"><t t-out="line.start_time" t-options="{'widget': 'float_time'}"/></td>
                                                <td class="text-center"><t t-out="line.end_time" t-options="{'widget': 'float_time'}"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="alert alert-info mb-0">
                                No timetable schedule configured for this class.
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="invoices" role="tabpanel" aria-labelledby="invoices-tab">
                        <div class="card shadow-sm border-0 p-4">
                            <h5 class="text-secondary mb-3">Fee Invoices &amp; Payments</h5>
                            <div class="table-responsive" t-if="invoices">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Invoice Reference</th>
                                            <th>Date</th>
                                            <th>Total</th>
                                            <th>Payment Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="invoices" t-as="inv">
                                            <tr>
                                                <td>
                                                    <a t-attf-href="/my/invoices/#{inv.id}"><t t-out="inv.name"/></a>
                                                </td>
                                                <td><t t-out="inv.invoice_date"/></td>
                                                <td><t t-out="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/></td>
                                                <td>
                                                    <span t-attf-class="badge bg-#{'success' if inv.payment_state == 'paid' else 'warning' if inv.payment_state == 'not_paid' else 'info'}">
                                                        <t t-out="inv.payment_state.replace('_', ' ').capitalize() if inv.payment_state else 'Not Paid'"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="alert alert-info mb-0">
                                No fee invoices generated.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_student_bus" name="Student Bus Location">
        <t t-call="portal.portal_layout">
            <t t-set="head">
                <meta http-equiv="refresh" content="30"/>
            </t>
            <div class="container mt-3">
                <a t-attf-href="/my/school/student/#{student.id}" class="btn btn-link px-0 mb-2">
                    <i class="fa fa-arrow-left me-1"/> Back to <t t-out="student.name"/>
                </a>
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h4 class="text-primary mb-3"><i class="fa fa-bus me-2"/>Bus Live Location</h4>
                        <div t-if="not vehicle" class="alert alert-info mb-0">No vehicle is assigned to this student's route.</div>
                        <t t-if="vehicle">
                            <div t-if="route.is_vehicle_replaced" class="alert alert-warning">
                                Regular vehicle temporarily replaced. Showing the replacement vehicle.
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Route:</strong> <t t-out="route.name"/></p>
                                    <p class="mb-1"><strong>Boarding Point:</strong> <t t-out="student.van_boarding_point_id.name or '-'"/></p>
                                    <p class="mb-1"><strong>Vehicle:</strong> <t t-out="vehicle.name"/> (<t t-out="vehicle.vehicle_number"/>)</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Driver:</strong> <t t-out="driver.name or '-'"/></p>
                                    <p class="mb-1"><strong>Driver Contact:</strong>
                                        <a t-if="driver.phone" t-attf-href="tel:#{driver.phone}"><t t-out="driver.phone"/></a>
                                        <t t-else="">-</t>
                                    </p>
                                    <p class="mb-1" t-if="vehicle.caretaker_id"><strong>Caretaker:</strong>
                                        <t t-out="vehicle.caretaker_id.name"/>
                                        <t t-if="vehicle.caretaker_id.phone">
                                            (<a t-attf-href="tel:#{vehicle.caretaker_id.phone}"><t t-out="vehicle.caretaker_id.phone"/></a>)
                                        </t>
                                    </p>
                                    <p class="mb-1"><strong>Last Updated:</strong>
                                        <t t-if="minutes_ago is not None">
                                            <t t-out="vehicle.last_location_at" t-options="{'widget': 'datetime'}"/>
                                            (<t t-out="minutes_ago"/> min ago)
                                        </t>
                                        <t t-else="">No location received yet</t>
                                    </p>
                                </div>
                            </div>
                            <div t-if="minutes_ago is not None and minutes_ago &gt; 15" class="alert alert-secondary mt-2 mb-0">
                                Location is more than 15 minutes old. The vehicle may not be on a trip right now.
                            </div>
                        </t>
                    </div>
                </div>
                <div t-if="embed_url" class="card shadow-sm border-0 mb-3">
                    <div class="ratio ratio-16x9">
                        <iframe t-att-src="embed_url" style="border:0;" loading="lazy" title="Bus location map"/>
                    </div>
                    <div class="card-body py-2 small text-muted">
                        Page refreshes every 30 seconds.
                        <a t-att-href="vehicle.location_map_url" target="_blank" class="ms-2">Open in full map</a>
                    </div>
                </div>
                <a t-if="vehicle and vehicle.gps_tracking_url" t-att-href="vehicle.gps_tracking_url" target="_blank"
                   class="btn btn-outline-primary mb-4">Open provider tracking page</a>
            </div>
        </t>
    </template>
    <template id="portal_driver_home" name="Driver Trips">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3 class="mb-1"><i class="fa fa-bus me-2"/>My Trips</h3>
                <p class="text-muted">Today: <t t-out="today" t-options="{'widget': 'date'}"/></p>
                <div t-if="not routes" class="alert alert-info">No routes are assigned to you today.</div>
                <t t-foreach="routes" t-as="route">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5 class="text-primary mb-1"><t t-out="route.name"/></h5>
                            <p class="mb-2 small">
                                Vehicle: <strong><t t-out="route.effective_vehicle_id.name or '-'"/></strong>
                                (<t t-out="route.effective_vehicle_id.vehicle_number or '-'"/>)
                                | Students: <strong><t t-out="len(route.student_ids)"/></strong>
                            </p>
                            <div t-if="route.is_vehicle_replaced" class="alert alert-warning py-1 small mb-2">
                                Regular vehicle replaced today. Use <t t-out="route.effective_vehicle_id.name"/>.
                            </div>
                            <div class="d-grid gap-2 d-sm-flex">
                                <t t-foreach="[('morning', 'Morning Pickup'), ('evening', 'Evening Drop')]" t-as="trip">
                                    <t t-set="att" t-value="done.get((route.id, trip[0]))"/>
                                    <a t-attf-href="/my/driver/trip/#{route.id}/#{trip[0]}"
                                       t-attf-class="btn btn-lg #{'btn-success' if att and att.marked_by_id else 'btn-outline-primary'}">
                                        <t t-out="trip[1]"/>
                                        <t t-if="att and att.marked_by_id">
                                            <i class="fa fa-check ms-1"/> <t t-out="att.present_count"/>/<t t-out="len(att.line_ids)"/>
                                        </t>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_driver_trip" name="Driver Trip Attendance">
        <t t-call="portal.portal_layout">
            <div class="container mt-3 mb-5">
                <h4 class="mb-1 text-primary"><t t-out="route.name"/></h4>
                <p class="mb-2">
                    <strong><t t-out="dict(attendance._fields['trip_type'].selection).get(attendance.trip_type)"/></strong>
                    | <t t-out="attendance.date" t-options="{'widget': 'date'}"/>
                    | <t t-out="vehicle.name or '-'"/> (<t t-out="vehicle.vehicle_number or '-'"/>)
                </p>
                <div t-if="saved" class="alert alert-success py-2">
                    Attendance saved. Boarded <t t-out="attendance.present_count"/>, Absent <t t-out="attendance.absent_count"/>.
                </div>

                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h6 class="mb-2"><i class="fa fa-map-marker me-1"/>Live Location</h6>
                        <button type="button" id="o_driver_gps_btn" class="btn btn-warning w-100"
                                t-att-data-route-id="route.id" t-att-data-csrf="request.csrf_token()">
                            Start Sharing Location
                        </button>
                        <div id="o_driver_gps_status" class="small text-muted mt-2">Location sharing is off. Keep this page open during the trip.</div>
                    </div>
                </div>

                <form t-attf-action="/my/driver/attendance/#{attendance.id}/save" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div t-if="not attendance.line_ids" class="alert alert-info">No students are assigned to this route.</div>
                    <t t-foreach="attendance.line_ids" t-as="line">
                        <div class="card border-0 shadow-sm mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong><t t-out="line.student_id.name"/></strong>
                                        <div class="small text-muted">
                                            <t t-out="line.student_id.class_id.name"/> - <t t-out="line.student_id.section_id.name"/>
                                            | Stop: <t t-out="line.boarding_point_id.name or '-'"/>
                                        </div>
                                        <div class="small" t-if="line.student_id.parent_contact">
                                            <i class="fa fa-phone me-1"/><t t-out="line.student_id.parent_contact"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="btn-group w-100 mt-2" role="group">
                                    <input type="radio" class="btn-check" t-attf-name="status_#{line.id}" value="boarded"
                                           t-attf-id="b_#{line.id}" t-att-checked="line.status == 'boarded'"/>
                                    <label class="btn btn-outline-success" t-attf-for="b_#{line.id}">Boarded</label>
                                    <input type="radio" class="btn-check" t-attf-name="status_#{line.id}" value="absent"
                                           t-attf-id="a_#{line.id}" t-att-checked="line.status == 'absent'"/>
                                    <label class="btn btn-outline-danger" t-attf-for="a_#{line.id}">Absent</label>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-if="attendance.line_ids" class="position-sticky bottom-0 bg-white py-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">Save Attendance</button>
                    </div>
                </form>
                <a href="/my/driver" class="btn btn-link px-0 mt-2"><i class="fa fa-arrow-left me-1"/>Back to My Trips</a>
            </div>
            <script>
                (function () {
                    var btn = document.getElementById('o_driver_gps_btn');
                    var statusEl = document.getElementById('o_driver_gps_status');
                    if (!btn) { return; }
                    var watchId = null;
                    var waiting = false;
                    function setStatus(text) { statusEl.textContent = text; }
                    function send(pos) {
                        // send at most one location every 30 seconds
                        if (waiting) { return; }
                        waiting = true;
                        setTimeout(function () { waiting = false; }, 30000);
                        var fd = new FormData();
                        fd.append('csrf_token', btn.dataset.csrf);
                        fd.append('route_id', btn.dataset.routeId);
                        fd.append('lat', pos.coords.latitude);
                        fd.append('lon', pos.coords.longitude);
                        fd.append('speed', (pos.coords.speed || 0) * 3.6);
                        fetch('/my/driver/location', {method: 'POST', body: fd, credentials: 'same-origin'})
                            .then(function (r) { return r.json(); })
                            .then(function (d) {
                                setStatus(d.ok ? 'Location sent at ' + new Date().toLocaleTimeString() : 'Error: ' + d.error);
                            })
                            .catch(function () { setStatus('Network error. Will retry.'); waiting = false; });
                    }
                    btn.addEventListener('click', function () {
                        if (!navigator.geolocation) { setStatus('GPS is not supported on this device.'); return; }
                        if (watchId !== null) {
                            navigator.geolocation.clearWatch(watchId);
                            watchId = null;
                            btn.textContent = 'Start Sharing Location';
                            btn.classList.replace('btn-danger', 'btn-warning');
                            setStatus('Location sharing stopped.');
                            return;
                        }
                        watchId = navigator.geolocation.watchPosition(send, function (err) {
                            setStatus('GPS error: ' + err.message);
                        }, {enableHighAccuracy: true, maximumAge: 10000, timeout: 20000});
                        btn.textContent = 'Stop Sharing Location';
                        btn.classList.replace('btn-warning', 'btn-danger');
                        setStatus('Waiting for GPS...');
                    });
