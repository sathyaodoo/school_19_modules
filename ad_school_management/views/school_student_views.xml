<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.tree</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="admission_no"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="roll_number"/>
                <field name="student_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="admission_no"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="roll_number"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('school.student', 'photo', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div>Admission No: <field name="admission_no"/></div>
                                <div>Class: <field name="class_id"/> - <field name="section_id"/></div>
                                <div>Roll No: <field name="roll_number"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
 
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="student_status" widget="statusbar" statusbar_visible="draft,approved,enrolled,promoted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partner"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                string="Contact Profile">
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Student Name" required="1"/>
                        </h1>
                        <h3>
                            <field name="admission_no" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Academic Information">
                            <field name="academic_year_id"/>
                            <field name="class_id"/>
                            <field name="section_id"/>
                            <field name="roll_number"/>
                            <field name="gpa" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Contact Information">
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Info" name="personal_info">
                            <group>
                                <group>
                                    <field name="date_of_birth"/>
                                    <field name="gender"/>
                                    <field name="blood_group"/>
                                    <field name="nationality_id"/>
                                </group>
                                <group>
                                    <field name="religion"/>
                                    <field name="caste"/>
                                </group>
                            </group>
                            <group string="Additional Information">
                                <group>
                                    <field name="hobbies"/>
                                </group>
                                <group>
                                    <field name="date_of_leaving"/>
                                    <field name="reason_for_leaving" invisible="not date_of_leaving"/>
                                </group>
                            </group>
                        </page>
                        <page string="Parents &amp; Guardians" name="parents">
                            <field name="parent_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="relation"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="occupation"/>
                                    <field name="annual_income"/>
                                    <field name="student_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Facilities" name="facilities">
                            <group>
                                <group string="Transport">
                                    <field name="transport_route_id"/>
                                    <field name="van_boarding_point_id"/>
                                    <field name="vehicle_id" invisible="not transport_route_id"/>
                                </group>
                            </group>
                            <group string="Transport Fee History" invisible="not transport_route_id">
                                <field name="transport_fee_ids" nolabel="1" readonly="1" colspan="2">
                                    <list>
                                        <field name="billing_month"/>
                                        <field name="amount"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Route Change Requests">
                                <field name="route_change_request_ids" nolabel="1" readonly="1" colspan="2">
                                    <list>
                                        <field name="request_date"/>
                                        <field name="current_route_id"/>
                                        <field name="requested_route_id"/>
                                        <field name="reason"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Medical &amp; Notes" name="medical_notes">
                            <group>
                                <field name="emergency_contact"/>
                                <field name="medical_notes" placeholder="Any allergies, chronic illnesses, or general medical notes..."/>
                            </group>
                        </page>
                         <page string="Sponsorship &amp; Scholarship" name="sponsorship">
                            <group>
                                <group string="Sponsor">
                                    <field name="sponsor_name"/>
                                    <field name="sponsor_type"/>
                                    <field name="sponsor_contact"/>
                                    <field name="sponsorship_status"/>
                                    <field name="relationship_to_student"/>
                                </group>
                                <group string="Scholarship">
                                    <field name="scholarship_amount"/>
                                    <field name="scholarship_type"/>
                                    <field name="scholarship_approved_date"/>
                                    <field name="scholarship_expiry_date"/>
                                    <field name="merit_tag"/>
                                </group>
                            </group>
                            <group string="Scholarship / Discount Applied in Fees">
                                <field name="fee_concession_total"/>
                            </group>
                            <field name="student_fee_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="structure_id"/>
                                    <field name="academic_year_id"/>
                                    <field name="amount"/>
                                    <field name="discount"/>
                                    <field name="scholarship"/>
                                    <field name="scholarship_value"/>
                                    <field name="concession_amount" sum="Total"/>
                                    <field name="net_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fees" name="fees">
                            <group>
                                <group>
                                    <field name="fee_total"/>
                                    <field name="fee_concession_total"/>
                                </group>
                                <group>
                                    <field name="fee_paid_total"/>
                                    <field name="fee_due_total" decoration-danger="fee_due_total &gt; 0"/>
                                </group>
                            </group>
                            <field name="student_fee_ids" readonly="1" nolabel="1">
                                <list decoration-success="state == 'paid'" decoration-warning="state == 'invoiced'">
                                    <field name="name"/>
                                    <field name="structure_id"/>
                                    <field name="academic_year_id"/>
                                    <field name="net_amount" sum="Total"/>
                                    <field name="paid_amount" sum="Total"/>
                                    <field name="due_amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Store Purchases" name="store">
                            <field name="store_order_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="name" string="Sale ID"/>
                                    <field name="date_order" string="Date"/>
                                    <field name="amount_total" string="Amount" sum="Total"/>
                                    <field name="store_payment_mode"/>
                                    <field name="store_payment_status" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                            <page string="Siblings" name="siblings">
                            <field name="sibling_ids">
                                <list editable="bottom">
                                    <field name="sibling_student_id"/>
                                    <field name="sibling_class_id"/>
                                    <field name="sibling_section_id"/>
                                    <field name="sibling_admission_no"/>
                                    <field name="relation_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('admission_no', 'ilike', self)]"/>
                <field name="admission_no"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <filter string="Enrolled" name="enrolled" domain="[('student_status', '=', 'enrolled')]"/>
                <filter string="Alumni" name="alumni" domain="[('student_status', '=', 'alumni')]"/>
                <group>
                    <filter string="Class" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new student!
            </p>
        </field>
    </record>
</odoo>