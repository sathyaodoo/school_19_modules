<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_grade_tree" model="ir.ui.view">
        <field name="name">school.grade.tree</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="grade"/>
                <field name="min_mark"/>
                <field name="max_mark"/>
                <field name="grade_point"/>
            </list>
        </field>
    </record>

    <record id="view_school_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="grade" placeholder="e.g. A+"/>
                            <field name="grade_point" placeholder="e.g. 4.0"/>
                        </group>
                        <group>
                            <field name="min_mark" placeholder="e.g. 90"/>
                            <field name="max_mark" placeholder="e.g. 100"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Grading System</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your Grading System rules!
            </p>
        </field>
    </record>
</odoo>
