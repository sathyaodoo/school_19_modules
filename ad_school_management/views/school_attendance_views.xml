<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance is taken once a day: Present or Absent. -->
    <record id="view_school_attendance_tree" model="ir.ui.view">
        <field name="name">school.attendance.tree</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'present'" decoration-danger="status == 'absent'">
                <field name="date"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="status" widget="badge" decoration-success="status == 'present'" decoration-danger="status == 'absent'"/>
            </list>
        </field>
    </record>

    <record id="view_school_attendance_form" model="ir.ui.view">
        <field name="name">school.attendance.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="section_id" domain="[('class_id', '=', class_id)]"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="status" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_attendance_calendar" model="ir.ui.view">
        <field name="name">school.attendance.calendar</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Calendar" date_start="date" color="status">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_school_attendance_graph" model="ir.ui.view">
        <field name="name">school.attendance.graph</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance Analysis" type="bar">
                <field name="class_id"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="view_school_attendance_pivot" model="ir.ui.view">
        <field name="name">school.attendance.pivot</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Analysis">
                <field name="class_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="date"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Present" name="present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="absent" domain="[('status', '=', 'absent')]"/>
                <group>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:day'}"/>
                    <filter string="Class" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_attendance" model="ir.actions.act_window">
        <field name="name">Student Attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,calendar,graph,pivot,form</field>
        <!-- The day's attendance only (old afternoon records stay hidden) -->
        <field name="domain">[('session', '=', 'morning')]</field>
        <field name="search_view_id" ref="view_school_attendance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mark Student Attendance!
            </p>
            <p>Attendance is taken once a day: each student is Present or Absent.</p>
        </field>
    </record>
</odoo>
