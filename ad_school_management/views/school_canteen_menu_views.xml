<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_canteen_menu_form" model="ir.ui.view">
        <field name="name">school.canteen.menu.form</field>
        <field name="model">school.canteen.menu</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_archive_menu" type="object" string="Archive"
                            invisible="state != 'published'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="week_start_date" readonly="state != 'draft'"/>
                            <field name="week_end_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="published_date" readonly="1"/>
                        </group>
                    </group>

                    <field name="menu_line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="day"/>
                            <field name="meal_id"/>
                            <field name="food_item_ids" widget="many2many_tags"/>
                            <field name="remarks"/>
                        </list>
                    </field>

                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_canteen_menu_list" model="ir.ui.view">
        <field name="name">school.canteen.menu.list</field>
        <field name="model">school.canteen.menu</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="week_start_date"/>
                <field name="week_end_date"/>
                <field name="created_by"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="action_school_canteen_menu" model="ir.actions.act_window">
        <field name="name">Weekly/Monthly Menu</field>
        <field name="res_model">school.canteen.menu</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>