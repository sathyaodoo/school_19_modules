<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Student Activity Score (monthly) ================= -->
    <record id="view_school_student_score_list" model="ir.ui.view">
        <field name="name">school.student.activity.score.list</field>
        <field name="model">school.student.activity.score</field>
        <field name="arch" type="xml">
            <list string="Student Activity Score" create="0" edit="0" delete="0">
                <field name="month_label" string="Month"/>
                <field name="month" column_invisible="1"/>
                <field name="student_id"/>
                <field name="admission_no" optional="show"/>
                <field name="class_id" optional="show"/>
                <field name="section_id" optional="hide"/>
                <field name="house_id" optional="show"/>
                <field name="activity_count" sum="Activities"/>
                <field name="prize_count" sum="Prizes" optional="show"/>
                <field name="participation_points" sum="Participation" optional="show"/>
                <field name="prize_points" sum="Prize" optional="show"/>
                <field name="total_score" sum="Total Score" decoration-success="total_score &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_score_pivot" model="ir.ui.view">
        <field name="name">school.student.activity.score.pivot</field>
        <field name="model">school.student.activity.score</field>
        <field name="arch" type="xml">
            <pivot string="Student Activity Score">
                <field name="student_id" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="total_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_student_score_graph" model="ir.ui.view">
        <field name="name">school.student.activity.score.graph</field>
        <field name="model">school.student.activity.score</field>
        <field name="arch" type="xml">
            <graph string="Student Activity Score" type="bar">
                <field name="month" interval="month"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_school_student_score_search" model="ir.ui.view">
        <field name="name">school.student.activity.score.search</field>
        <field name="model">school.student.activity.score</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="admission_no"/>
                <field name="class_id"/>
                <field name="house_id"/>
                <filter string="This Month" name="this_month"
                        domain="[('month', '=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="last_month"
                        domain="[('month', '=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Has Prizes" name="has_prizes" domain="[('prize_count', '&gt;', 0)]"/>
                <group>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Group (House)" name="group_house" context="{'group_by': 'house_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_student_score" model="ir.actions.act_window">
        <field name="name">Student Scores</field>
        <field name="res_model">school.student.activity.score</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_school_student_score_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_school_student_score_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_school_student_score_graph')})]"/>
        <field name="search_view_id" ref="view_school_student_score_search"/>
        <field name="context">{'search_default_group_month': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scores yet</p>
            <p>A student earns points every time they take part in a school activity (and more for a prize).
               Add participants to an activity and their monthly score appears here.</p>
        </field>
    </record>

    <menuitem id="menu_school_student_score" name="Student Scores" parent="menu_school_activities_root"
              action="action_school_student_score" sequence="25"
              groups="ad_school_management.group_school_admin,ad_school_management.group_school_principal,ad_school_management.group_school_teacher"/>

</odoo>