<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Groups (Houses) ================= -->
    <record id="view_school_house_list" model="ir.ui.view">
        <field name="name">school.house.list</field>
        <field name="model">school.house</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="board"/>
                <field name="color" widget="color_picker"/>
                <field name="student_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_school_house_search" model="ir.ui.view">
        <field name="name">school.house.search</field>
        <field name="model">school.house</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="CBSE" name="cbse" domain="[('board', '=', 'cbse')]"/>
                <filter string="State Board" name="state" domain="[('board', '=', 'state')]"/>
                <group>
                    <filter string="Board" name="group_board" context="{'group_by': 'board'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_house" model="ir.actions.act_window">
        <field name="name">Student Groups (Houses)</field>
        <field name="res_model">school.house</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_board': 1}</field>
    </record>

    <!-- ================= Class Groups (with leaders) ================= -->
    <record id="view_school_class_house_list" model="ir.ui.view">
        <field name="name">school.class.house.list</field>
        <field name="model">school.class.house</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="class_id"/>
                <field name="house_id"/>
                <field name="board" optional="show"/>
                <field name="male_leader_id"/>
                <field name="female_leader_id"/>
                <field name="male_count"/>
                <field name="female_count"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_house_form" model="ir.ui.view">
        <field name="name">school.class.house.form</field>
        <field name="model">school.class.house</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Group">
                            <field name="class_id" readonly="1"/>
                            <field name="house_id" readonly="1"/>
                            <field name="board"/>
                        </group>
                        <group string="Student Leaders">
                            <field name="male_leader_id" options="{'no_create': True}"/>
                            <field name="female_leader_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group><field name="male_count"/></group>
                        <group><field name="female_count"/></group>
                    </group>
                    <field name="student_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="admission_no"/>
                            <field name="section_id"/>
                            <field name="gender"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_class_house_search" model="ir.ui.view">
        <field name="name">school.class.house.search</field>
        <field name="model">school.class.house</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="house_id"/>
                <filter string="Missing Male Leader" name="no_male_leader" domain="[('male_leader_id', '=', False)]"/>
                <filter string="Missing Female Leader" name="no_female_leader" domain="[('female_leader_id', '=', False)]"/>
                <group>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Group" name="group_house" context="{'group_by': 'house_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_class_house" model="ir.actions.act_window">
        <field name="name">Class Groups &amp; Leaders</field>
        <field name="res_model">school.class.house</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_class': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No class groups yet</p>
            <p>Set the Board (CBSE / State) on each class: its groups are created automatically.</p>
        </field>
    </record>

    <!-- ================= Class form: board + groups ================= -->
    <record id="view_school_class_form_house" model="ir.ui.view">
        <field name="name">school.class.form.house</field>
        <field name="model">school.class</field>
        <field name="inherit_id" ref="ad_school_management.view_school_class_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="board"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_auto_assign_groups" type="object" string="Assign Students to Groups"
                            invisible="not board" class="btn-secondary"
                            help="Places every student of this class who has no group yet, balanced by gender."/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Student Groups" name="student_groups" invisible="not board">
                    <field name="class_house_ids">
                        <list create="false" delete="false" editable="bottom">
                            <field name="class_id" column_invisible="True"/>
                            <field name="house_id" readonly="1"/>
                            <field name="male_leader_id" options="{'no_create': True}"/>
                            <field name="female_leader_id" options="{'no_create': True}"/>
                            <field name="male_count"/>
                            <field name="female_count"/>
                            <field name="student_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================= Student: group ================= -->
    <record id="view_school_student_form_house" model="ir.ui.view">
        <field name="name">school.student.form.house</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="ad_school_management.view_school_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='section_id']" position="after">
                <field name="class_board" invisible="1"/>
                <field name="house_id" options="{'no_create': True}"/>
                <field name="leader_role" invisible="not leader_role"/>
            </xpath>
        </field>
    </record>

    <record id="view_school_student_tree_house" model="ir.ui.view">
        <field name="name">school.student.list.house</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="ad_school_management.view_school_student_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='section_id']" position="after">
                <field name="house_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_school_student_search_house" model="ir.ui.view">
        <field name="name">school.student.search.house</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="ad_school_management.view_school_student_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='section_id']" position="after">
                <field name="house_id"/>
                <filter string="No Group" name="no_house" domain="[('house_id', '=', False)]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter string="Group (House)" name="group_by_house" context="{'group_by': 'house_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>