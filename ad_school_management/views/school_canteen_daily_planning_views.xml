<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_canteen_daily_planning_form" model="ir.ui.view">
        <field name="name">school.canteen.daily.planning.form</field>
        <field name="model">school.canteen.daily.planning</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculate" type="object" string="Recalculate"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="planning_date"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                    </group>

                    <group string="Headcount">
                        <group>
                            <field name="hosteller_count" readonly="1"/>
                            <field name="staff_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="booked_day_scholar_count" readonly="1"/>
                            <field name="event_participant_count"/>
                        </group>
                    </group>

                    <group>
                        <field name="total_expected_qty" readonly="1"/>
                    </group>

                    <field name="planning_line_ids">
                        <list editable="bottom">
                            <field name="meal_id"/>
                            <field name="expected_qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_canteen_daily_planning_list" model="ir.ui.view">
        <field name="name">school.canteen.daily.planning.list</field>
        <field name="model">school.canteen.daily.planning</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="planning_date"/>
                <field name="hosteller_count"/>
                <field name="staff_count"/>
                <field name="booked_day_scholar_count"/>
                <field name="event_participant_count"/>
                <field name="total_expected_qty" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_school_canteen_daily_planning" model="ir.actions.act_window">
        <field name="name">Daily Meal Planning</field>
        <field name="res_model">school.canteen.daily.planning</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Meal Bookings (day scholars) ============ -->
    <record id="view_school_canteen_meal_booking_list" model="ir.ui.view">
        <field name="name">school.canteen.meal.booking.list</field>
        <field name="model">school.canteen.meal.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="booking_date &lt; current_date"
                  decoration-bf="booking_date == current_date">
                <field name="booking_date"/>
                <field name="booking_day"/>
                <field name="meal_id"/>
                <field name="meal_start_time" widget="float_time"/>
                <field name="meal_end_time" widget="float_time"/>
                <field name="student_id"/>
                <field name="admission_no"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="created_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_canteen_meal_booking_form" model="ir.ui.view">
        <field name="name">school.canteen.meal.booking.form</field>
        <field name="model">school.canteen.meal.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Student">
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="admission_no"/>
                            <field name="class_id"/>
                            <field name="section_id"/>
                        </group>
                        <group string="Meal">
                            <field name="booking_date"/>
                            <field name="booking_day"/>
                            <field name="meal_id" options="{'no_create': True}"/>
                            <label for="meal_start_time" string="Meal Time"/>
                            <div class="o_row">
                                <field name="meal_start_time" widget="float_time" nolabel="1"/>
                                <span>to</span>
                                <field name="meal_end_time" widget="float_time" nolabel="1"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_canteen_meal_booking_search" model="ir.ui.view">
        <field name="name">school.canteen.meal.booking.search</field>
        <field name="model">school.canteen.meal.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="admission_no"/>
                <field name="meal_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <filter string="Today" name="today"
                        domain="[('booking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Tomorrow" name="tomorrow"
                        domain="[('booking_date', '=', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('booking_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Booking Date" name="filter_booking_date" date="booking_date"/>
                <group>
                    <filter string="Date" name="group_date" context="{'group_by': 'booking_date:day'}"/>
                    <filter string="Meal" name="group_meal" context="{'group_by': 'meal_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Section" name="group_section" context="{'group_by': 'section_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_canteen_meal_booking" model="ir.actions.act_window">
        <field name="name">Meal Bookings</field>
        <field name="res_model">school.canteen.meal.booking</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_school_canteen_meal_booking_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book a meal for a day scholar</p>
            <p>Bookings are counted in the Daily Meal Planning of that day.</p>
        </field>
    </record>

</odoo>
