<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         INGREDIENTS = standard products, bought and kept in stock.
         Not sold directly: they are used in the dishes' recipes.
         ================================================================ -->
    <record id="view_school_canteen_food_item_list" model="ir.ui.view">
        <field name="name">product.template.canteen.ingredient.list</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <field name="name"/>
                <field name="categ_id"/>
                <field name="uom_id" string="Unit" options="{'no_create': True}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="standard_price" string="Cost" widget="monetary"/>
                <field name="qty_available" string="On Hand" readonly="1"/>
                <field name="is_storable" column_invisible="1"/>
                <field name="type" column_invisible="1"/>
                <field name="purchase_ok" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_school_canteen_food_item" model="ir.actions.act_window">
        <field name="name">Ingredients</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_school_canteen_food_item_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_template_only_form_view')})]"/>
        <field name="domain">[('is_canteen_item', '=', True)]</field>
        <!-- Goods tracked in stock, bought (Purchase), not sold -->
        <field name="context">{'default_is_canteen_item': True, 'default_type': 'consu', 'default_is_storable': True, 'default_sale_ok': False, 'default_purchase_ok': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a kitchen ingredient</p>
            <p>Bread, egg, dal, rice, oil, salt ... Buy them with Canteen Purchases; they are
               taken out of stock automatically when the dishes that use them are sold.</p>
        </field>
    </record>

    <!-- ================================================================
         DISHES = standard products sold at the counter, each with a
         Recipe (Kit Bill of Materials) of ingredients for ONE plate.
         ================================================================ -->
    <record id="view_school_canteen_dish_list" model="ir.ui.view">
        <field name="name">product.template.canteen.dish.list</field>
        <field name="model">product.template</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Dish"/>
                <field name="categ_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="list_price" string="Selling Price" widget="monetary"/>
                <field name="canteen_recipe_cost" widget="monetary"/>
                <field name="canteen_margin" widget="monetary"
                       decoration-danger="canteen_recipe_bom_id and canteen_margin &lt; 0"
                       decoration-success="canteen_recipe_bom_id and canteen_margin &gt;= 0"/>
                <field name="canteen_recipe_summary"/>
                <field name="canteen_recipe_bom_id" column_invisible="1"/>
                <field name="type" column_invisible="1"/>
                <button name="action_canteen_open_recipe" type="object" string="Recipe"
                        icon="fa-list-ul" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_school_canteen_dish" model="ir.actions.act_window">
        <field name="name">Dishes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_school_canteen_dish_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_template_only_form_view')})]"/>
        <field name="domain">[('is_canteen_dish', '=', True)]</field>
        <!-- Goods sold (Sales), not bought, not stocked themselves: their
             recipe ingredients are -->
        <field name="context">{'default_is_canteen_dish': True, 'default_type': 'consu', 'default_is_storable': False, 'default_sale_ok': True, 'default_purchase_ok': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a dish</p>
            <p>Sambar Rice, Bread Omelette ... Set its Selling Price, then click
               <b>Recipe</b> to list the ingredients for one plate.</p>
        </field>
    </record>

    <!-- ================================================================
         RECIPES = standard Bills of Materials of type Kit
         ================================================================ -->
    <record id="action_school_canteen_recipe" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_tmpl_id.is_canteen_dish', '=', True)]</field>
        <field name="context">{'default_type': 'phantom', 'default_product_qty': 1.0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a recipe</p>
            <p>Choose the dish, keep Quantity = 1 (one plate) and BoM Type = Kit, and list
               the ingredients with the quantity used for one plate.</p>
        </field>
    </record>

    <record id="action_school_canteen_food_category" model="ir.actions.act_window">
        <field name="name">Food Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
