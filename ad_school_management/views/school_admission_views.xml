<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_admission_tree" model="ir.ui.view">
        <field name="name">school.admission.tree</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-success="state in ('approved', 'enrolled')" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state in ('approved', 'enrolled')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_school_admission_form" model="ir.ui.view">
        <field name="name">school.admission.form</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_enroll" type="object" string="Enroll" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state not in ('submitted', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,enrolled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Applicant Details">
                        <group>
                            <field name="first_name" placeholder="First Name"/>
                            <field name="last_name" placeholder="Last Name"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="email" placeholder="email@example.com"/>
                            <field name="phone" placeholder="+1234567890"/>
                            <field name="student_id" invisible="state not in ('approved', 'enrolled')"/>
                        </group>
                    </group>
                    <group string="Address Details">
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id" options="{'no_open': True}"/>
                            <field name="country_id" options="{'no_open': True}"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <group string="Academic Preferences">
                        <group>
                            <field name="academic_year_id"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="section_id" domain="[('class_id', '=', class_id)]"/>
                        </group>
                    </group>
                    <group string="Parent/Guardian Details">
                        <group>
                            <field name="parent_name"/>
                            <field name="parent_relation"/>
                        </group>
                        <group>
                            <field name="parent_phone"/>
                            <field name="parent_email"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_admission_search" model="ir.ui.view">
        <field name="name">school.admission.search</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <search>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Enrolled" name="enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <record id="action_school_admission" model="ir.actions.act_window">
        <field name="name">Admissions</field>
        <field name="res_model">school.admission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_admission_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register an Admission Application!
            </p>
        </field>
    </record>
</odoo>
