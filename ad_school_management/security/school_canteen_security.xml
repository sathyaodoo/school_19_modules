<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Canteen staff work in the standard apps: they maintain ingredients,
         dishes and prices (Products: Create), recipes (Manufacturing:
         Bills of Materials), sell (Sales), buy
         (Purchase), move stock (Inventory) and invoice (Accounting:
         Invoicing). Existing canteen staff receive these rights when the
         module is upgraded. -->
    <record id="group_school_canteen_staff" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('product.group_product_manager')),
            (4, ref('mrp.group_mrp_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice')),
        ]"/>
    </record>
</odoo>