            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_library_manager')), (4, ref('group_hostel_manager'))]"/>
