<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ad_school_management" model="ir.module.category">
            <field name="name">School Management</field>
            <field name="description">Category for School Management application access rights.</field>
            <field name="sequence">20</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_ad_school_management">
            <field name="name">School Management Staff</field>
            <field name="category_id" ref="module_category_ad_school_management"/>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_school_portal">
            <field name="name">School Portal Role</field>
            <field name="category_id" ref="module_category_ad_school_management"/>
            <field name="sequence">20</field>
        </record>

        <record id="module_category_library" model="ir.module.category">
            <field name="name">Library</field>
            <field name="description">Library management system.</field>
            <field name="sequence">220</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library Access</field>
            <field name="category_id" ref="module_category_library"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_library_user" model="res.groups">
            <field name="name">Library User</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_library_manager" model="res.groups">
            <field name="name">Library Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="module_category_hostel" model="ir.module.category">
            <field name="name">Hostel</field>
            <field name="description">Hostel management system.</field>
            <field name="sequence">230</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hostel">
            <field name="name">Hostel Access</field>
            <field name="category_id" ref="module_category_hostel"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_hostel_user" model="res.groups">
            <field name="name">Hostel User</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hostel_manager" model="res.groups">
            <field name="name">Hostel Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_hostel_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_school_student" model="res.groups">
            <field name="name">Student Portal User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_portal"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_school_parent" model="res.groups">
            <field name="name">Parent Portal User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_portal"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_school_teacher" model="res.groups">
            <field name="name">School Teacher</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_library_user')), (4, ref('group_hostel_user'))]"/>
        </record>

        <record id="group_school_accountant" model="res.groups">
            <field name="name">School Accountant</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
