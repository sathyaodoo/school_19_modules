<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ad_school_management" model="ir.module.category">
            <field name="name">School Management</field>
            <field name="description">Category for School Management application access rights.</field>
            <field name="sequence">20</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_ad_school_management">
            <field name="name">School Management Staff</field>
            <field name="category_id" ref="module_category_ad_school_management"/>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_school_portal">
            <field name="name">School Portal Role</field>
            <field name="category_id" ref="module_category_ad_school_management"/>
            <field name="sequence">20</field>
        </record>

        <record id="module_category_library" model="ir.module.category">
            <field name="name">Library</field>
            <field name="description">Library management system.</field>
            <field name="sequence">220</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library Access</field>
            <field name="category_id" ref="module_category_library"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_library_user" model="res.groups">
            <field name="name">Library User</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_library_manager" model="res.groups">
            <field name="name">Library Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="module_category_hostel" model="ir.module.category">
            <field name="name">Hostel</field>
            <field name="description">Hostel management system.</field>
            <field name="sequence">230</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hostel">
            <field name="name">Hostel Access</field>
            <field name="category_id" ref="module_category_hostel"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_hostel_user" model="res.groups">
            <field name="name">Hostel User</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hostel_manager" model="res.groups">
            <field name="name">Hostel Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_hostel"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_hostel_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_school_student" model="res.groups">
            <field name="name">Student Portal User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_portal"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_school_parent" model="res.groups">
            <field name="name">Parent Portal User</field>
            <field name="privilege_id" ref="res_groups_privilege_school_portal"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_school_teacher" model="res.groups">
            <field name="name">School Teacher</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_library_user')), (4, ref('group_hostel_user'))]"/>
        </record>

        <record id="group_school_accountant" model="res.groups">
            <field name="name">School Accountant</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_hr_manager" model="res.groups">
            <field name="name">School HR Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">18</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_canteen_staff" model="res.groups">
            <field name="name">School Canteen Staff</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">19</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_mmd" model="res.groups">
            <field name="name">School MMD (Material Management Department)</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_principal" model="res.groups">
            <field name="name">School Principal</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_library_manager')), (4, ref('group_hostel_manager'))]"/>
        </record>

        <record id="group_school_admin" model="res.groups">
            <field name="name">School Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_ad_school_management"/>
            <field name="sequence">25</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_library_manager')), (4, ref('group_hostel_manager'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('ad_school_management.group_school_admin'))]"/>
        </record>
    </data>

    <data>

        <record id="rule_student_own_profile" model="ir.rule">
            <field name="name">Student: Own Profile Only</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('partner_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_parent_child_profile" model="ir.rule">
            <field name="name">Parent: Child Profile Only</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[('parent_ids.partner_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_teacher_assigned_classes" model="ir.rule">
            <field name="name">Teacher: Assigned Classes Only</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">['|', ('class_id.teacher_ids.user_id', '=', user.id), ('class_id.class_teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_resignation_own_record" model="ir.rule">
            <field name="name">Staff: Own Resignation Letter Only</field>
            <field name="model_id" ref="model_school_staff_resignation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_teacher')), (4, ref('group_school_accountant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>


        <record id="rule_all_student_admin" model="ir.rule">
            <field name="name">Administrator: All Students</field>
            <field name="model_id" ref="model_school_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_school_principal')), (4, ref('group_school_admin'))]"/>
        </record>

        <record id="rule_teacher_attendance" model="ir.rule">
            <field name="name">Teacher: Mark Attendance for Assigned Classes</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">['|', ('class_id.teacher_ids.user_id', '=', user.id), ('class_id.class_teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
        </record>

        <record id="rule_all_attendance_admin" model="ir.rule">
            <field name="name">Administrator: All Attendance</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_school_principal')), (4, ref('group_school_admin'))]"/>
        </record>

        <record id="rule_parent_attendance" model="ir.rule">
            <field name="name">Parent: View Child Attendance</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">[('student_id.parent_ids.partner_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_student_attendance" model="ir.rule">
            <field name="name">Student: View Own Attendance</field>
            <field name="model_id" ref="model_school_attendance"/>
            <field name="domain_force">[('student_id.partner_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_teacher_timetable" model="ir.rule">
            <field name="name">Teacher: Timetable View</field>
            <field name="model_id" ref="model_school_timetable"/>
            <field name="domain_force">['|', ('class_id.teacher_ids.user_id', '=', user.id), ('class_id.class_teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_all_timetable_admin" model="ir.rule">
            <field name="name">Administrator: All Timetables</field>
            <field name="model_id" ref="model_school_timetable"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_school_principal')), (4, ref('group_school_admin'))]"/>
        </record>

        <record id="rule_student_timetable" model="ir.rule">
            <field name="name">Student: View Class Timetable</field>
            <field name="model_id" ref="model_school_timetable"/>
            <field name="domain_force">[('class_id', '=', user.partner_id.student_ids.class_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_parent_timetable" model="ir.rule">
            <field name="name">Parent: View Child Class Timetable</field>
            <field name="model_id" ref="model_school_timetable"/>
            <field name="domain_force">[('class_id', 'in', user.partner_id.parent_ids.student_ids.mapped('class_id').ids)]</field>
            <field name="groups" eval="[(4, ref('group_school_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>