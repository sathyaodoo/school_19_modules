<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weekly grid of one teacher's periods, used by the portal page
         (/my/timetable). Needs: grid, highlight_today. -->
    <template id="teacher_timetable_grid" name="Teacher Timetable Grid">
        <div t-if="not grid['rows']" class="alert alert-light border">
            No periods are assigned to you yet.
        </div>
        <div t-else="" class="table-responsive">
            <table class="table table-bordered table-sm align-middle o_school_teacher_timetable mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 110px;">Time</th>
                        <th t-foreach="grid['days']" t-as="day"
                            t-attf-class="text-center #{'table-primary' if highlight_today and day[0] == grid['today'] else ''}">
                            <t t-out="day[1]"/>
                            <div t-if="highlight_today and day[0] == grid['today']" class="small fw-normal">Today</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="grid['rows']" t-as="row">
                        <td class="fw-bold text-nowrap"><t t-out="row['label']"/></td>
                        <td t-foreach="row['cells']" t-as="cell"
                            t-attf-class="#{'table-primary' if highlight_today and grid['days'][cell_index][0] == grid['today'] else ''}">
                            <div t-foreach="cell" t-as="line" class="small">
                                <div class="fw-bold" t-out="line.subject_id.name"/>
                                <div>
                                    <t t-out="line.timetable_id.class_id.name"/> -
                                    <t t-out="line.timetable_id.section_id.name"/>
                                </div>
                                <div class="text-muted">Room <t t-out="line.classroom"/></div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

