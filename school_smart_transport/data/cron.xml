<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_stc_close_stale_trips" model="ir.cron">
        <field name="name">Smart Transport: finish trips left running for 8 hours</field>
        <field name="model_id" ref="model_school_transport_trip"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_stale_trips(hours=8)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="config_default" model="school.transport.config">
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
