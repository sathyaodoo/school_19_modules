<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- same convention as the other school records: "own branch + shared main school" -->
    <record id="rule_school_curriculum_company" model="ir.rule">
        <field name="name">Curriculum: own branch + shared main school</field>
        <field name="model_id" ref="model_school_curriculum"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
