<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_alumni" model="ir.sequence">
            <field name="name">Alumni Code</field>
            <field name="code">school.alumni</field>
            <field name="prefix">ALM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_alumni_donation" model="ir.sequence">
            <field name="name">Alumni Donation</field>
            <field name="code">school.alumni.donation</field>
            <field name="prefix">DON/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_alumni_mentorship" model="ir.sequence">
            <field name="name">Alumni Mentorship</field>
            <field name="code">school.alumni.mentorship</field>
            <field name="prefix">MEN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>