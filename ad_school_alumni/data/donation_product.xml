<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product used on donation invoices. Set its Income Account to your
             "Donation Income" account (Accounting tab of the product). -->
        <record id="product_alumni_donation" model="product.product">
            <field name="name">Alumni Donation</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="default_code">DONATION</field>
        </record>
    </data>
</odoo>
