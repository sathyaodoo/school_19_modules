<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_alumni_donation_receipt" model="ir.actions.report">
        <field name="name">Donation Receipt</field>
        <field name="model">school.alumni.donation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ad_school_alumni.report_alumni_donation_receipt</field>
        <field name="report_file">ad_school_alumni.report_alumni_donation_receipt</field>
        <field name="print_report_name">'Donation Receipt - %s' % object.name</field>
        <field name="binding_model_id" ref="model_school_alumni_donation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_alumni_donation_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3 class="text-center mb-4">DONATION RECEIPT</h3>
                        <table class="table table-sm table-borderless" style="font-size: 14px;">
                            <tr>
                                <td style="width: 25%;"><strong>Receipt No.</strong></td>
                                <td>: <span t-out="o.name"/></td>
                                <td style="width: 20%;"><strong>Date</strong></td>
                                <td>: <span t-field="o.date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Received From</strong></td>
                                <td>: <span t-out="o.alumni_id.name"/></td>
                                <td><strong>Alumni Code</strong></td>
                                <td>: <span t-out="o.alumni_id.code"/></td>
                            </tr>
                            <tr>
                                <td><strong>Batch</strong></td>
                                <td>: <span t-out="o.alumni_id.batch or '-'"/></td>
                                <td><strong>Payment Mode</strong></td>
                                <td>: <span t-field="o.payment_mode"/></td>
                            </tr>
                            <tr>
                                <td><strong>Purpose</strong></td>
                                <td>: <span t-field="o.purpose"/></td>
                                <td><strong>Reference</strong></td>
                                <td>: <span t-out="o.payment_reference or '-'"/></td>
                            </tr>
                        </table>
                        <div class="mt-4 p-3 border text-center" style="font-size: 18px;">
                            Amount Received: <strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                            <div class="small text-muted mt-1">
                                (<span t-out="o.currency_id.amount_to_text(o.amount)"/>)
                            </div>
                        </div>
                        <p class="mt-4">
                            We gratefully acknowledge your generous contribution to
                            <strong t-out="o.company_id.name"/>. Thank you for supporting your school.
                        </p>
                        <table class="table table-borderless mt-5" style="font-size: 13px;">
                            <tr>
                                <td class="text-start" style="width: 50%;">
                                    Received by: <span t-out="o.received_by.name or ''"/>
                                </td>
                                <td class="text-end">____________________<br/>Authorised Signatory</td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>