<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_alumni_donation_list" model="ir.ui.view">
        <field name="name">school.alumni.donation.list</field>
        <field name="model">school.alumni.donation</field>
        <field name="arch" type="xml">
            <list string="Donations" decoration-muted="state == 'cancelled'" decoration-success="state == 'received'">
                <field name="name"/>
                <field name="date"/>
                <field name="alumni_id"/>
                <field name="graduation_year" options="{'format': false}" optional="show"/>
                <field name="purpose"/>
                <field name="payment_mode" optional="show"/>
                <field name="event_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'pledged'" decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_school_alumni_donation_form" model="ir.ui.view">
        <field name="name">school.alumni.donation.form</field>
        <field name="model">school.alumni.donation</field>
        <field name="arch" type="xml">
            <form string="Donation">
                <header>
                    <button name="action_pledge" type="object" string="Pledge" invisible="state != 'draft'"
                            groups="ad_school_alumni.group_alumni_manager"/>
                    <button name="action_receive" type="object" string="Mark as Received" class="oe_highlight"
                            invisible="state not in ('draft', 'pledged')" groups="ad_school_alumni.group_alumni_manager"/>
                    <button name="action_print_receipt" type="object" string="Print Receipt" icon="fa-print"
                            invisible="state != 'received'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'" groups="ad_school_alumni.group_alumni_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'" groups="ad_school_alumni.group_alumni_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pledged,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="alumni_id" options="{'no_create': True}" readonly="state == 'received'"/>
                            <field name="graduation_year" options="{'format': false}"/>
                            <field name="date" readonly="state == 'received'"/>
                            <field name="amount" readonly="state == 'received'"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="state == 'received'"/>
                        </group>
                        <group>
                            <field name="purpose"/>
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="payment_mode"/>
                            <field name="payment_reference"/>
                            <field name="anonymous"/>
                            <field name="received_by" invisible="not received_by"/>
                            <field name="received_date" invisible="not received_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_alumni_donation_search" model="ir.ui.view">
        <field name="name">school.alumni.donation.search</field>
        <field name="model">school.alumni.donation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="alumni_id"/>
                <field name="event_id"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Pledged" name="pledged" domain="[('state', '=', 'pledged')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Purpose" name="group_purpose" context="{'group_by': 'purpose'}"/>
                    <filter string="Alumni" name="group_alumni" context="{'group_by': 'alumni_id'}"/>
                    <filter string="Graduation Year" name="group_year" context="{'group_by': 'graduation_year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_alumni_donation_pivot" model="ir.ui.view">
        <field name="name">school.alumni.donation.pivot</field>
        <field name="model">school.alumni.donation</field>
        <field name="arch" type="xml">
            <pivot string="Donations">
                <field name="purpose" type="row"/>
                <field name="date" interval="year" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_alumni_donation_graph" model="ir.ui.view">
        <field name="name">school.alumni.donation.graph</field>
        <field name="model">school.alumni.donation</field>
        <field name="arch" type="xml">
            <graph string="Donations" type="bar">
                <field name="date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_school_alumni_donation" model="ir.actions.act_window">
        <field name="name">Donations</field>
        <field name="res_model">school.alumni.donation</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_school_alumni_donation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No donations yet.</p>
            <p>Record what alumni give, mark it as received and print a receipt.</p>
        </field>
    </record>

    <record id="action_school_alumni_donation_analysis" model="ir.actions.act_window">
        <field name="name">Donation Analysis</field>
        <field name="res_model">school.alumni.donation</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '=', 'received')]</field>
        <field name="search_view_id" ref="view_school_alumni_donation_search"/>
    </record>
</odoo>