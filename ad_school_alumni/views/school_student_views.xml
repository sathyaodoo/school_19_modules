<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student form: Student -> Graduate button and links to the alumni side -->
    <record id="view_school_student_form_alumni" model="ir.ui.view">
        <field name="name">school.student.form.alumni</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="ad_school_management.view_school_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='student_status']" position="before">
                <field name="alumni_id" invisible="1"/>
                <button name="action_graduate" type="object" string="Graduate" icon="fa-graduation-cap"
                        invisible="alumni_id or not id" groups="ad_school_alumni.group_alumni_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_alumni" type="object" class="oe_stat_button" icon="fa-graduation-cap"
                        string="Alumni Profile" invisible="not alumni_id"/>
                <button name="action_view_mentorships" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not mentorship_count">
                    <field name="mentorship_count" widget="statinfo" string="Mentors"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>